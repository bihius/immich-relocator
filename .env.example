# ------------ DATABASE ---------------------------------------------
# Find these in your Immich .yml or .env file:
PGDATABASE="immich"
PGUSER="postgres"
PGPORT="5432"
PGPASSWORD="add-your-DB-password-here"
# Run the following command to find the IP:
# docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' immich_postgres
PGHOST="your-pg-container-ip"


# ------------ API KEY ----------------------------------------------
# Only needed to run a Storage Template Migration Job. It needs the following permissions: job.create, queue.read
# Leave empty to skip the Storage Template Migration job entirely.
IMMICH_API_KEY=""


# ------------ PATHS ------------------------------------------------
# Where your Immich yml is stored:
COMPOSE_DIR="/path/to/your/immich/folder"
# Find this in your Immich .yml or .env file under UPLOAD_LOCATION:
UPLOAD_MOUNT="/mnt/path-to-immichfolder"
# Find this in your Immich .yml under UPLOAD_LOCATION (on the right side):
SRC_DIR="/path-to-immich-upload-folder/"


# ------------ INDIVIDUAL EXTERNAL LIBRARIES ------------------------
# IMPORTANT!!! You can add as many Individual External Libraries as you want, as long as they do not surpass 
# the amount of users your server has. Ideally, you'd set an Individual External Library per user, and that will 
# give you the neater and safer result. This is especially true considering that, by design, only one user can be 
# the External Library owner in Immich.
# But, even if unsupported, it is currently technically possible to relocate items that you don't own 
# to an External Library that you own (Single Individual External Library). If this is what you want, 
# leave the INDIVIDUAL_USERS_COUNT to 1, even if you have multiple Immich users. Then just fill in the remaining 
# variables using a single user block. 
# It's possible, but not recommended. You have been warned!

# Change the count for multiple Individual External Libraries, default is single Individual External Library
# IMPORTANT: UserShared is not considered in this counter, only individual users are.
INDIVIDUAL_USERS_COUNT=1


# Add one block per Individual External Library. INDIVIDUAL_USERS_COUNT controls how many blocks are read.
# You can add as many user blocks as you like!

# Change the two fields below to reflect your actual External Library name and destination.
# Library Names must match Immich GUI: Administration -> External Libraries -> Name
USER_1_LIB_NAME="User1 Pictures"
USER_1_DEST="/mnt/path-to-user1-ext-library/"
# Leave label field as it is if you do not use Storage Label, and do not intend to use the Folder Restructure feature
# Labels must match the Storage Label set in: Administration -> Users -> Edit -> "Storage Label"
USER_1_LABEL="JohnDeFstUser"

# Uncomment the following block to add a second External Library (including the label field)
#USER_2_LIB_NAME="User2 Pictures"
#USER_2_DEST="/mnt/path-to-user2-ext-library/"
# Leave label field as it is if you do not use Storage Label, and do not intend to use the Folder Restructure feature
#USER_2_LABEL="MaryDeScndUser"



# ------------ SHARED USER & CHANGE OWNERSHIP ------------ ----------
# Changes ownership of media contained in shared albums to a defined user. Handy for partner sharing case-scenario.
# Leave a null "00000000-0000-0000-0000-000000000000" UUID value to  never change  media ownerships and to ignore this part.
# Find user UUID value in Immich GUI: Administration -> Users -> Profile -> ID
OWNER_SHARED="00000000-0000-0000-0000-000000000000"

# External library shared with your partner:
DEST_SHARED="/mnt/path-to-your-shared-ext-library/"
LIBRARY_NAME_SHARED="Shared User Pictures"

# ------------ DB BACKUPS -------------------------------------------
# Immich Relocator performs a database backup of your Immich current db state before anything gets relocated.
# Here you can decide how many db backups you want to keep. Default is 5. The oldest beyond this count will be deleted:
BACKUP_RETENTION_COUNT=5
