# ------------ DATABASE ---------------------------------------------
# Find these in your Immich .yml or .env file:
PGDATABASE="immich"
PGUSER="postgres"
PGPORT="5432"
PGPASSWORD="add-your-DB-password-here"
# Run the following command to find the IP:
# docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' immich_postgres
# Note: PGHOST is passed to the psql wrapper script inside the container.
PGHOST="your-pg-container-ip"
# Postgres container name (default: immich_postgres). Change if using a custom name.
POSTGRES_CONTAINER="immich_postgres"


# ------------ API KEY - Storage Template Migration Job -------------
# Only needed to run a Storage Template Migration Job. It needs the following permissions: job.create, queue.read
# Leave empty to skip the Storage Template Migration job entirely.
IMMICH_API_KEY=""
# URL to Immich API (default: http://localhost:2283). Change if running remotely or on a different port.
IMMICH_API_URL="http://localhost:2283"


# ------------ PATHS ------------------------------------------------
# Where your Immich yml is stored:
COMPOSE_DIR="/path/to/your/immich/folder"
# Find this in your Immich .yml or .env file under UPLOAD_LOCATION:
UPLOAD_MOUNT="/mnt/path-to-immichfolder"
# Find this in your Immich .yml under UPLOAD_LOCATION (on the right side):
SRC_DIR="/path-to-immich-upload-folder/"


# ------------ EXTERNAL LIBRARIES COUNT -----------------------------
# You can relocate to as many External Libraries as you want, as long as they do not surpass the amount of
# users your server has. Ideally, you'd set an External Library per user, and that will give you the neater
# and safer result. This is especially true considering that, by design, only one user can be the sole owner 
# of an External Library in Immich.
# But, even if unsupported, it is currently technically possible to relocate the items that you own and 
# the items that you don't own (were not uploaded by you) to the same External Library that only 
# one user owns (Single External Library).
# Alternatively, each user can have their own (Multi External Library).

# If Single is what you want, fill in the Single External Library values in the relative block, and leave
# the EXTERNAL_LIBRARIES_COUNT to 1. This way, the files of every user relocate to the same External Library.
# This is possible, but not officially supported by Immich and therefore not recommended. You have been warned!

# If Multiple is what you want, add a User block per Immich user in the Multi External Library block, then
# update the EXTERNAL_LIBRARIES_COUNT to match the number of users minus the Pseudo UserShared, if you have one.

# IMPORTANT: Pseudo UserShared is not considered in this counter.
EXTERNAL_LIBRARIES_COUNT=1


# ------------ SINGLE EXTERNAL LIBRARY -------------------------------
# Relocate the files of every user to the same External Library
 
# The Single External Library values below are ignored if EXTERNAL_LIBRARIES_COUNT value is set to anything
# bigger than 1. So, you can ignore these values if you use Multi External Libraries

# Library Name must match Immich GUI: Administration -> External Libraries -> Name
SINGLE_LIB_NAME="Everyone Pictures"
# Path to External Library on host:
SINGLE_DEST="/mnt/path-to-single-ext-library/"


# ------------ MULTI EXTERNAL LIBRARIES -------------------------------
# Relocate files to separate External Libraries. Each Immich user can have its own.

# If you'd like your files to be relocated to Multiple External Libraries, Immich Relocator offers the option 
# to assign an External Library per Immich user. The Users have priority over the Single External Library 
# as long as the EXTERNAL_LIBRARIES_COUNT is set to anything bigger than 1.

# Add one block per User. Remember to update the EXTERNAL_LIBRARIES_COUNT in the section above for each new 
# user you add. You can add as many user blocks as you like!

# IMPORTANT NOTES & DEPENDENCIES:
# - If you use Storage Label, add that to the USER_N_LABEL, NOT the UUID.
# - The first Immich "admin" user cannot use UUID here, only "admin" or Storage Label are acceptable values.
# - Storage Template Migration job is highly recommended. Please enable it by adding API key in appropriate 
#   section above, or make sure to run the job manually via Immich GUI.

# To set Storage Label via Immich GUI: Administration -> Users -> Edit -> "Storage Label"

# Library Names must match Immich GUI: Administration -> External Libraries -> Name
USER_1_LIB_NAME="User1 Pictures"
# Path to User's External Library on host:
USER_1_DEST="/mnt/path-to-user1-ext-library/"
# UUID, "admin" or Storage Label are all accepted values (read notes above). But Storage Label is highly recommended.
USER_1_LABEL="JohnDeFstUser"

# USER2 BLOCK EXAMPLE:
# Uncomment the following variables block to add a second External Library. You can add as many user blocks as you like!
# Library Names must match Immich GUI: Administration -> External Libraries -> Name
#USER_2_LIB_NAME="User2 Pictures"
# Path to User's External Library on host:
#USER_2_DEST="/mnt/path-to-user2-ext-library/"
# UUID, "admin" or Storage Label are all accepted values (read notes above). But Storage Label is highly recommended.
#USER_2_LABEL="MaryDeScndUser"


# ------------ FOLDER RESTRUCTURE ------------------------------------
# IMPORTANT: This feature depends on:
# - Multi External Libraries is enabled (EXTERNAL_LIBRARIES_COUNT is bigger than 1)
# - Storage Template Migration job feature is enabled (you added a correct API key in relevant block)
# If the conditions above are not met, then even a "true" value will be ignored!

# Add "true" to the following variable if you would like Immich Relocator to restructure your folder before 
# relocating the files. 
# Look at the readme example to see how the final result will look like.
FOLDER_RESTRUCTURE=false


# ------------ Pseudo UserShared - SHARED USER & CHANGE OWNERSHIP ----
# IMPORTANT: This feature depends on:
# - Multi External Libraries is enabled (EXTERNAL_LIBRARIES_COUNT is bigger than 1)
# - Storage Template Migration job feature is enabled (you added a correct API key in relevant block)
# - Every picture or video of the Immich library has been added to at least one album
# - For a neater result, enabling the Folder Restructure feature is also suggested, please read info in readme

# Immich Relocator refers to "UserShared", as a "special" (Pseudo) User allowed to have a "special" External Library.
# When files are relocated there the behaviour is different than Single or Multi External Libraries.
# Any file that gets relocated to the UserShared's External Library will get an ownership change, so that
# UserShared (which you can name in Immich however you like), will now own all the relocated files.
# This is useful for partners wanting to overcome the default limitations of Immich Partner Sharing via a third user.

# To enable this feature:
# Simply add the UUID of this special user in the OWNER_SHARED value, then fill in the rest.
# Leave a null "00000000-0000-0000-0000-000000000000" UUID value to keep this feature disabled (default)

# LIMITATIONS: 
# - Every file contained in an album that is shared will end up in UserShared External Library, not 
#   only the files contained in an album shared with your partner. 
# - Immich Relocator only changes the ownership of an item, so things like faces and stacks stay with 
#   the old (original) owner. UserShared will not see these faces in their People section and Immich does 
#   not automatically re-generate faces for the new owner.
# Read more about Pseudo UserShared and its limits in the readme. There you'll also find detailed usage examples.

# Find user UUID value in Immich GUI: Administration -> Users -> Profile -> ID
OWNER_SHARED="00000000-0000-0000-0000-000000000000"
# Path to the External Library shared with your partner:
DEST_SHARED="/mnt/path-to-your-shared-ext-library/"
# Exact name of the External Library shared with your partner:
LIBRARY_NAME_SHARED="Shared User Pictures"


# ------------ DB BACKUPS -------------------------------------------
# Immich Relocator performs a database backup of your Immich current db state before anything gets relocated.
# Here you can decide how many db backups you want to keep. Default is 5. The oldest beyond this count will be deleted:
BACKUP_RETENTION_COUNT=5
